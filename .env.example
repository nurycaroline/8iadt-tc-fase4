# Variáveis de ambiente da Fase 3 (Node + Python). Copie para `.env` e ajuste.
# NUNCA versione o `.env` com segredos — ver docs/07-privacidade-e-seguranca.md.

# ── Backend Node (Express) ──
PORT=3000
LOG_LEVEL=info
# URL do serviço de IA (FastAPI). Em docker-compose use http://ai-service:8000.
AI_SERVICE_URL=http://localhost:8000
AI_TIMEOUT_MS=120000

# ── Persistência (SQLite) ──
DB_PATH=data/_storage/app.sqlite

# ── Storage: 'local' (fallback em disco) ou 'azure' (Azure Blob Storage) ──
STORAGE_BACKEND=local
STORAGE_DIR=data/_storage

# ── Azure Blob Storage (apenas quando STORAGE_BACKEND=azure) ──
# Obtenha a connection string no portal Azure (Storage account > Access keys).
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=monitoramento
# Expiração (minutos) do SAS token das URLs de leitura.
AZURE_SAS_EXPIRY_MINUTES=60

# ── Fase 7 — Privacidade e Segurança (LGPD) ──
# Credencial de serviço do backend (F7-01). Vazio => auth desabilitada (demo/fallback local).
# Defina para exigir o header `x-api-key` nas rotas de dados (/pacientes, /analisar, /casos).
API_KEY=
# Força negar quando API_KEY não está configurada (fail-safe explícito p/ produção).
AUTH_REQUIRED=false
# Credencial que o backend envia ao ai-service (FastAPI valida `X-API-Key` se definida).
AI_SERVICE_API_KEY=
# Allowlist de origens do CORS (CSV). Vazio => '*' em dev e same-origin em produção.
CORS_ORIGINS=
# Retenção de dados em dias (F7-04). 0 => sem expiração automática. Rode `npm run retencao`.
RETENTION_DAYS=0
# (Opcional) Azure Key Vault para segredos (F7-07); fallback p/ as variáveis acima quando vazio.
AZURE_KEY_VAULT_URL=
