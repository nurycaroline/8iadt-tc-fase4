# Variáveis de ambiente da Fase 3 (Node + Python). Copie para `.env` e ajuste.
# NUNCA versione o `.env` com segredos — ver docs/07-privacidade-e-seguranca.md.

# ── Backend Node (Express) ──
PORT=3000
LOG_LEVEL=info
# URL do serviço de IA (FastAPI). Em docker-compose use http://ai-service:8000.
AI_SERVICE_URL=http://localhost:8000
AI_TIMEOUT_MS=120000

# ── Persistência (SQLite) ──
DB_PATH=data/_storage/app.sqlite

# ── Storage: 'local' (fallback em disco) ou 'azure' (Azure Blob Storage) ──
STORAGE_BACKEND=local
STORAGE_DIR=data/_storage

# ── Azure Blob Storage (apenas quando STORAGE_BACKEND=azure) ──
# Obtenha a connection string no portal Azure (Storage account > Access keys).
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=monitoramento
# Expiração (minutos) do SAS token das URLs de leitura.
AZURE_SAS_EXPIRY_MINUTES=60
